# ------------------------------------------------------------------
# Template only — copy this file to .env.local for local development.
# `.env.local` is gitignored and should hold the real values.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Google Sheets / Apps Script data bridge
# ------------------------------------------------------------------
# The spreadsheet that holds properties and buyer enquiries.
GOOGLE_SHEETS_ID=1C-Lo4uCVsVvX87NuJmb3vKk-nyia_wB1DCq8HpWCp88

# Deployed Apps Script web app URL (ends in /exec). Leave blank to use the
# built-in preview catalogue and local enquiry store.
GOOGLE_APPS_SCRIPT_URL=

# Shared secret stored in the Apps Script Script Properties as ADMIN_TOKEN.
# Server-side only. Never prefix this with NEXT_PUBLIC_. Use a hex value so
# Next.js dotenv expansion does not interpret any $ characters.
# Required for the bundled apps-script/Code.gs bridge; leave blank when the
# bridge already exposes public read endpoints (the app will not send a token).
GOOGLE_APPS_SCRIPT_ADMIN_TOKEN=

# ------------------------------------------------------------------
# Admin authentication (server-side session cookie)
# ------------------------------------------------------------------
ADMIN_USERNAME=
# Generate with: npm run hash-password -- "your-strong-password"
# Paste the full scrypt:salt:hash value. Do not use a raw scrypt$... value in
# .env files: Next.js expands $NAME sequences and would corrupt the hash.
ADMIN_PASSWORD_HASH=
# Long random string (32+ chars, e.g. hex) used to sign the HttpOnly session cookie.
# Required in production; the server refuses to start sessions without it.
AUTH_SECRET=

# ------------------------------------------------------------------
# Public brand / contact configuration (safe to expose)
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919847012345
NEXT_PUBLIC_OFFICE_PHONE=+91 484 290 8000
NEXT_PUBLIC_OFFICE_PHONE_E164=914842908000

# Optional comma-separated extra hosts for next/image optimisation.
# Unknown https hosts still render through a safe <img> fallback.
NEXT_PUBLIC_IMAGE_HOSTS=
